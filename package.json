{
  "name": "marp-prod-workdir",
  "version": "1.0.0",
  "description": "Self-contained Marp presentation production environment with themes, templates, and content",
  "main": "USER_GUIDE.md",
  "scripts": {
    "build": "marp presentations/**/*.md --output presentations/dist",
    "build:pdf": "marp presentations/**/*.md --pdf --output presentations/dist",
    "build:pptx": "marp presentations/**/*.md --pptx --output presentations/dist",
    "build:html": "marp --input-dir presentations --html --output presentations/dist",
    "watch": "marp -w presentations/**/*.md --output presentations/dist",
    "new": "node scripts/new-presentation.js",
    "preview": "marp -p presentations/**/*.md"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@marp-team/marp-cli": "^4.3.1"
  }
}
